NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://closet:closet@localhost:5432/closet
# The server refuses to start with this placeholder. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Defaults to http://localhost:3000 in development; production requires an https:// URL.
BETTER_AUTH_URL=http://localhost:3000
# Item photos. These match the SeaweedFS service in docker-compose.yml (docker/seaweedfs/s3.json).
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and an R2 API token.
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=closet-photos
S3_ACCESS_KEY_ID=closet
S3_SECRET_ACCESS_KEY=closet-dev-secret
# BullMQ job queue; matches the Redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379
# Claude API key for tagging item photos (console: platform.claude.com). Optional: without it
# photos are processed but not tagged, and the add-item form is not pre-filled.
ANTHROPIC_API_KEY=
# fal.ai key for cutting items out of their photo background (fal.ai/dashboard/keys; the key
# needs only Requests: read and submit). Optional: without it photos keep their background.
FAL_KEY=
# Daily safety stop on estimated AI spend for the whole server, in dollars.
AI_DAILY_BUDGET_USD=8
# What one user's AI may cost in a calendar month, in dollars (style briefs included).
USER_MONTHLY_BUDGET_USD=5
# User ids (comma-separated) with roomier limits for testing: 30 outfit requests a day.
TESTER_USER_IDS=
# Where the embedding model (Marqo-FashionSigLIP, ~100 MB) is downloaded on first use.
MODEL_CACHE_DIR=.models

# Run the background jobs inside the API process (one command locally). Set to false in
# production and run `pnpm --filter @closet-ai/server start:worker` as its own process.
WORKERS_IN_API=true
