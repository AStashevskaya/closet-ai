NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://closet:closet@localhost:5432/closet
# The server refuses to start with this placeholder. Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Defaults to http://localhost:3000 in development; production requires an https:// URL.
BETTER_AUTH_URL=http://localhost:3000
