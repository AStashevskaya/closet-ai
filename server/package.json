{
  "name": "@closet-ai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "cutouts:backfill": "tsx --env-file=.env src/scripts/backfill-cutouts.ts",
    "embeddings:backfill": "tsx --env-file=.env src/scripts/backfill-embeddings.ts",
    "bench:worker": "tsx src/scripts/bench-worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@better-auth/expo": "^1.7.10",
    "@closet-ai/shared": "workspace:*",
    "@fastify/multipart": "^10.1.4",
    "@huggingface/transformers": "^4.3.1",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.16",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
