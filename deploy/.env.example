# Copy to deploy/.env on the server and fill in. Never commit the copy.
API_DOMAIN=api.example.com
# openssl rand -hex 32 (hex, because it goes inside the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudflare R2: the photos bucket and an API token limited to the two buckets below.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=closet-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Used by deploy/backup.sh only.
BACKUP_BUCKET=closet-backups

ANTHROPIC_API_KEY=
FAL_KEY=

# Safety stops, in dollars.
AI_DAILY_BUDGET_USD=8
USER_MONTHLY_BUDGET_USD=5
# Comma-separated user ids with roomier limits.
TESTER_USER_IDS=
LOG_LEVEL=info
