# The deployed API, for builds that run away from the dev computer. Leave unset in development:
# the phone then reaches the API on the computer Metro serves from.
# EXPO_PUBLIC_API_URL=https://api.example.com

# The published privacy policy, linked from the consent at sign-up.
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Where "Report a problem" (Profile) sends testers' letters. The row is hidden while unset.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
