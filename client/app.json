{
  "expo": {
    "name": "Closet",
    "slug": "closet-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "closetai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon-ios-light.png",
        "dark": "./assets/images/icon-ios-dark.png",
        "tinted": "./assets/images/icon-ios-tinted.png"
      },
      "bundleIdentifier": "com.stashevskaya.closet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6E4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stashevskaya.closet"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D6E4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "he",
            "ru"
          ]
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Closet uses the camera to photograph your clothes.",
          "photosPermission": "Closet adds photos of your clothes from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D6E4F1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json",
      "he": "./locales/he.json"
    },
    "extra": {
      "eas": {
        "projectId": "c1f14adc-398c-4e48-97c5-52eeddc9fd4d"
      }
    },
    "owner": "nastyastash"
  }
}
